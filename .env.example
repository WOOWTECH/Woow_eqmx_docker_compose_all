# ============================================
# EMQX Docker Compose 環境變數設定
# Environment Variables for EMQX Docker Compose
# ============================================

# ===== EMQX 版本 / EMQX Version =====
# 指定 EMQX 版本，預設為 latest
# Specify EMQX version, default is latest
EMQX_VERSION=latest

# ===== Dashboard 設定 / Dashboard Settings =====
# Dashboard 管理員帳號 / Dashboard admin username
EMQX_DASHBOARD_USER=admin

# Dashboard 管理員密碼 / Dashboard admin password
# 生產環境請務必修改！/ Change this in production!
EMQX_DASHBOARD_PASSWORD=public

# Dashboard 網頁介面端口 / Dashboard Web UI port
EMQX_DASHBOARD_PORT=18083

# ===== MQTT 端口設定 / MQTT Port Settings =====
# MQTT TCP 端口 / MQTT TCP port
MQTT_TCP_PORT=1883

# MQTT SSL/TLS 端口 / MQTT SSL/TLS port
MQTT_SSL_PORT=8883

# MQTT WebSocket 端口 / MQTT WebSocket port
MQTT_WS_PORT=8083

# MQTT WebSocket SSL 端口 / MQTT WebSocket SSL port
MQTT_WSS_PORT=8084

# ===== 節點設定 / Node Settings =====
# EMQX 節點主機名稱或 IP / EMQX node hostname or IP
EMQX_HOST=127.0.0.1

# ===== 安全設定 / Security Settings =====
# 是否允許匿名連接 / Allow anonymous connections
# 生產環境建議設為 false / Recommended to set false in production
EMQX_ALLOW_ANONYMOUS=true
